{
  "name": "abnormal-mail-services",
  "version": "1.5.0",
  "private": true,
  "description": "Abnormal email services website built with Next.js and Tailwind CSS, deployed to Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "cf:build": "pnpm check && pnpm format:check && pnpm build && wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2",
    "marked-smartypants": "^1.1.11",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1"
}
