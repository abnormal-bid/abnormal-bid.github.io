{
  "name": "abnormal-mail-services",
  "version": "1.2.0",
  "private": true,
  "description": "Abnormal email services website built with Next.js and Tailwind CSS, deployed to Cloudflare Workers.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm test",
    "cf:build": "pnpm check && pnpm build && wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  }
}
