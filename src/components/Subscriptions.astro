---
import { products, otherProduct } from "../data/site";
import Icon from "./Icon.astro";
import ProductCard from "./ProductCard.astro";
---

<section
  class="services-section"
  id="services"
  aria-labelledby="services-title"
>
  <div class="page-shell section-space">
    <div class="services-heading">
      <div>
        <p class="eyebrow">
          <span>01 /</span> Find your email
        </p>
        <h2 class="section-title" id="services-title">
          总有一个邮箱，
          <br class="mobile-break" />
          适合你的日常<span class="text-brand">。</span>
        </h2>
      </div>
      <p class="services-intro">
        从一人的灵感，到一群人的协作。
        <br />
        选一项想了解的服务，聊聊你的邮箱需求。
      </p>
    </div>
    <div class="services-grid">
      {products.map((product, index) => (
        <ProductCard product={product} index={index} />
      ))}
    </div>
    <div class="services-note">
      <p>
        <Icon name="chat" class="size-4" />
        有其他邮箱或团队配置需求？
        <button data-inquiry={otherProduct}>
          和我们聊聊 <Icon name="up-right" class="size-3" />
        </button>
      </p>
      <span>具体服务方案及费用，以咨询确认为准。</span>
    </div>
  </div>
</section>

<style>
  .services-section {
    border-top: 1px solid var(--border);
  }
  .services-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .eyebrow > span {
    margin-right: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .services-intro {
    padding-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .services-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .services-note p {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .services-note button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 32px;
    color: var(--text);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s;
  }
  .services-note button:hover {
    text-decoration-color: currentColor;
  }
  .mobile-break {
    display: none;
  }
  @media (max-width: 1023px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .services-heading {
      gap: 1rem;
    }
    .services-note {
      align-items: start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
  @media (max-width: 767px) {
    .services-heading {
      align-items: start;
      flex-direction: column;
      margin-bottom: 1.75rem;
    }
  }
  @media (max-width: 639px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .services-note {
      line-height: 1.8;
    }
  }
  @media (max-width: 380px) {
    .mobile-break {
      display: block;
    }
  }
</style>
