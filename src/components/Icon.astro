---
interface Props {
  name:
    | "arrow"
    | "up-right"
    | "check"
    | "plus"
    | "close"
    | "menu"
    | "shield"
    | "chat"
    | "spark"
    | "copy";
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Props["name"], string[]> = {
  arrow: ["M5 12h14m-6-6 6 6-6 6"],
  "up-right": ["M6 18 18 6M6 6h12v12"],
  check: ["m5 12 4 4L19 6"],
  plus: ["M12 5v14M5 12h14"],
  close: ["m6 6 12 12M6 18 18 6"],
  menu: ["M4 7h16M4 12h16M4 17h16"],
  shield: ["M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z", "m8 12 3 3 5-6"],
  chat: [
    "M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l1.3-4A8.5 8.5 0 1 1 21 11.5Z",
    "M8 10h8M8 14h5",
  ],
  spark: ["m12 3 2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3Z"],
  copy: [
    "M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z",
    "M16 8V4H4v12h4",
  ],
};
---

<svg
  class:list={["icon shrink-0 fill-none stroke-current", className]}
  viewBox="0 0 24 24"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
