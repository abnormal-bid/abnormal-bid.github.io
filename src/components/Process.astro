---
import { processSteps } from "../data/site";
import Icon from "./Icon.astro";
---

<section
  class="border-y border-[#f0eef7] bg-[#faf9fd] dark:border-line dark:bg-subtle"
  id="how-it-works"
  aria-labelledby="process-title"
>
  <div class="page-shell section-space">
    <div class="mb-9 flex flex-col justify-between gap-3 md:flex-row md:items-end md:gap-8">
      <div>
        <p class="eyebrow">LESS FRICTION, MORE CREATION</p>
        <h2 class="section-title" id="process-title">
          三步，把 AI 加入你的日常<span class="text-accent">。</span>
        </h2>
      </div>
      <p class="text-sm leading-loose text-muted">
        从选择到开通，
        <br class="hidden md:block" />
        每一步都先和你说清楚。
      </p>
    </div>
    <div class="grid gap-8 md:grid-cols-3 md:gap-10">
      {processSteps.map((step, index) => (
        <article class="relative pl-14 md:pl-0">
          <div class="absolute top-0 left-0 mb-5 flex flex-col items-center gap-4 md:static md:flex-row">
            <span class="text-3xl font-normal tracking-tight text-[#8875ba] dark:text-accent">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span
              class="hidden h-px flex-1 bg-[#e6e1f1] dark:bg-line md:block"
              aria-hidden="true"
            ></span>
            <Icon
              name={step.icon}
              class="text-[#9180be] dark:text-accent md:size-6"
            />
          </div>
          <h3 class="mb-2 text-base font-semibold md:mb-3 md:text-lg">
            {step.title}
          </h3>
          <p class="text-[0.9375rem] leading-loose text-muted md:text-base">
            {step.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
