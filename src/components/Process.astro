---
import { useCopy } from "../i18n";
import Icon from "./Icon.astro";
const { t, links } = useCopy(Astro.currentLocale);
---

<section class="process-section" id="how-it-works" aria-labelledby="process-title">
  <div class="page-shell section-space">
    <div class="process-heading">
      <div>
        <p class="eyebrow">
          <span class="mr-1 tabular-nums">03 /</span>A simple way to get started
        </p>
        <h2 class="section-title" id="process-title">
          {t.process.title}
          <span class="text-signal">{t.dot}</span>
        </h2>
      </div>
      <p class="process-intro">
        {t.process.intro[0]}
        {t.space}
        <br class="hidden md:block" />
        {t.process.intro[1]}
      </p>
    </div>
    <div class="process-grid">
      {t.process.steps.map((step, index) => (
        <article class="process-step">
          <div class="step-topline">
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="step-line" aria-hidden="true"></span>
            <span class="step-icon">
              <Icon name={step.icon} />
            </span>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-description">{step.description}</p>
          <a class="text-link step-link" href={links[step.link]}>
            {step.action} <Icon name="up-right" class="size-3.5" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    border-top: 1px solid var(--border);
  }
  .process-heading {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }
  .process-intro,
  .step-description {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }
  .process-grid {
    display: grid;
    gap: 2.25rem;
  }
  .process-step {
    min-width: 0;
  }
  .step-topline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.3rem;
  }
  .step-number {
    font-size: 2.75rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    /* 编号像被荧光笔划过：下半截压一道黄。字色是 --text，一半在页面底上、一半在黄上，
       所以深色模式的黄带换成暗黄（--step-band），浅色字在两边都清楚（11.5:1）。 */
    padding-inline: 0.06em;
    background: linear-gradient(transparent 56%, var(--step-band) 56% 90%, transparent 90%);
  }
  .step-line {
    height: 1px;
    flex: 1;
    background: var(--border);
  }
  .step-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    color: var(--text);
    background: var(--card);
  }
  .step-title {
    margin-bottom: 0.65rem;
    font-size: 18px;
    line-height: 1.4;
  }
  .step-description {
    max-width: 28rem;
  }
  .step-link {
    margin-top: 0.9rem;
  }
  @media (width >= 768px) {
    .process-heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3.75rem;
    }
    .process-intro {
      flex-shrink: 0;
    }
    .process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .step-topline {
      margin-bottom: 1.75rem;
    }
    .step-number {
      font-size: 3.25rem;
    }
  }
</style>
