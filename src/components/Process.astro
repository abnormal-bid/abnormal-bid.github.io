---
import { processSteps } from "../data/site";
import Icon from "./Icon.astro";
---

<section
  class="process-section"
  id="how-it-works"
  aria-labelledby="process-title"
>
  <div class="page-shell section-space">
    <div class="process-heading">
      <div>
        <p class="eyebrow">
          <span class="mr-1 tabular-nums">02 /</span>A simple way to get started
        </p>
        <h2 class="section-title" id="process-title">
          三步，开始使用你的邮箱<span class="text-brand">。</span>
        </h2>
      </div>
      <p class="process-intro">
        从需求到配置，
        <br class="hidden md:block" />
        每一步都先和你说清楚。
      </p>
    </div>
    <div class="process-grid">
      {processSteps.map((step, index) => (
        <article class="process-step">
          <div class="step-topline">
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="step-line" aria-hidden="true"></span>
            <span class="step-icon">
              <Icon name={step.icon} />
            </span>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-description">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    border-top: 1px solid var(--border);
  }
  .process-heading {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }
  .process-intro,
  .step-description {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }
  .process-grid {
    display: grid;
    gap: 2.25rem;
  }
  .process-step {
    min-width: 0;
  }
  .step-topline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.3rem;
  }
  .step-number {
    font-size: 2.75rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .step-line {
    height: 1px;
    flex: 1;
    background: var(--border);
  }
  .step-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    color: var(--text);
    background: var(--card);
  }
  .step-title {
    margin-bottom: 0.65rem;
    font-size: 18px;
    line-height: 1.4;
  }
  .step-description {
    max-width: 28rem;
  }
  @media (width >= 768px) {
    .process-heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3.75rem;
    }
    .process-intro {
      flex-shrink: 0;
    }
    .process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .step-topline {
      margin-bottom: 1.75rem;
    }
    .step-number {
      font-size: 3.25rem;
    }
  }
</style>
