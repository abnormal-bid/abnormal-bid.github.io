---
import Icon from "./Icon.astro";
import {
  products,
  serviceDurations,
  site,
  otherProduct,
  undecidedProduct,
} from "../data/site";
import { describeContact, formatInquiry, getContactLink } from "../lib/inquiry";
const initialInquiry = {
  product: undecidedProduct,
  duration: serviceDurations[0],
  notes: "",
};
const initialLink = getContactLink(site.contact, initialInquiry);
---

<dialog
  class="inquiry-dialog"
  id="inquiry-dialog"
  aria-labelledby="inquiry-title"
  aria-describedby="inquiry-description"
>
  <div class="inquiry-heading">
    <div class="inquiry-heading-top">
      <span class="inquiry-eyebrow">
        <span class="inquiry-heading-icon">
          <Icon name="chat" />
        </span>
        LET'S GET YOU STARTED
      </span>
      <button
        class="icon-button inquiry-close"
        id="close-dialog"
        aria-label="关闭咨询窗口"
      >
        <Icon name="close" />
      </button>
    </div>
    <h2 id="inquiry-title">
      从你的需求开始<span class="text-accent">。</span>
    </h2>
    <p id="inquiry-description">
      选好服务，整理需求，再联系咨询。
      <br />
      方案、报价与开通方式均需确认后再下单。
    </p>
  </div>
  <form class="inquiry-form" id="inquiry-form">
    <div class="inquiry-fields">
      <label class="inquiry-field">
        服务类型
        <select class="mt-2" id="inquiry-product" name="product">
          {products.map(({ name }) => (
            <option>{name}</option>
          ))}
          <option>{otherProduct}</option>
          <option value={undecidedProduct} selected>
            还没想好，想先咨询
          </option>
        </select>
      </label>
      <label class="inquiry-field">
        使用时长
        <select class="mt-2" id="inquiry-duration" name="duration">
          {serviceDurations.map((value) => (
            <option>{value}</option>
          ))}
        </select>
      </label>
    </div>
    <label class="inquiry-field">
      邮箱数量、域名或客户端需求{" "}
      <span class="ml-1 text-xs font-normal text-muted">选填</span>
      <textarea
        class="mt-2"
        id="inquiry-notes"
        name="notes"
        rows="3"
        maxlength="600"
        placeholder="例如：需要 3 个邮箱，已有域名，希望在手机和电脑上收发邮件。请勿填写密码或验证码。"
      ></textarea>
    </label>
    <div class="inquiry-preview">
      <span class="inquiry-preview-label">
        <Icon name="copy" class="size-3.5" />
        你的咨询内容
      </span>
      <p
        class="mt-1 text-xs leading-loose wrap-anywhere whitespace-pre-wrap"
        id="inquiry-text"
      >
        {formatInquiry(initialInquiry)}
      </p>
    </div>
    <div class="inquiry-contact" id="contact-info">
      <Icon name="chat" class="mt-1 size-4 text-accent" />
      <p class="text-xs leading-loose wrap-anywhere text-muted">
        {describeContact(site.contact)}
      </p>
    </div>
    <button
      class="btn btn-primary inquiry-copy"
      id="copy-inquiry"
      type="submit"
    >
      <Icon name="copy" />
      复制咨询内容
    </button>
    <a
      class="btn btn-outline inquiry-contact-link"
      id="contact-link"
      href={initialLink?.href}
      hidden={!initialLink}
      rel="noopener noreferrer"
      target={initialLink?.type === "telegram" ? "_blank" : undefined}
    >
      <span data-contact-label>{initialLink?.label || "前往咨询"}</span>
      <Icon name="up-right" />
    </a>
    <p class="inquiry-note">
      此页面仅帮你整理需求，不会提交订单或扣款。
      <br />
      咨询与服务适用
      <a
        class="underline underline-offset-4 hover:text-accent"
        href="/terms/"
        target="_blank"
        rel="noopener noreferrer"
      >
        服务条款<span class="sr-only">（新窗口打开）</span>
      </a>
      与
      <a
        class="underline underline-offset-4 hover:text-accent"
        href="/privacy/"
        target="_blank"
        rel="noopener noreferrer"
      >
        隐私政策<span class="sr-only">（新窗口打开）</span>
      </a>
      。
    </p>
    <p
      class="mt-2 text-center text-xs leading-relaxed text-accent empty:mt-0"
      id="copy-status"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</dialog>
<style>
  .inquiry-dialog {
    width: min(560px, calc(100% - 32px));
    max-height: calc(100dvh - 40px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    border: 1px solid var(--color-line);
    border-radius: 24px;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 24px 100px rgb(0 0 0 / 20%);
  }

  .inquiry-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .inquiry-dialog::backdrop {
    background: color-mix(in srgb, var(--color-brand-dark) 42%, transparent);
    backdrop-filter: blur(6px);
  }

  .inquiry-heading {
    flex-shrink: 0;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-subtle);
    padding: 20px 28px 22px;
  }

  .inquiry-heading-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .inquiry-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .inquiry-heading-icon {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
  }

  .inquiry-close {
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border-radius: 50%;
  }

  .inquiry-heading h2 {
    font-size: 28px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.045em;
  }

  .inquiry-heading p {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.9;
  }

  .inquiry-form {
    min-height: 0;
    padding: 26px 28px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  .inquiry-fields {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 14px;
    margin-bottom: 22px;
  }

  .inquiry-field {
    display: block;
    min-width: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .inquiry-field select,
  .inquiry-field textarea {
    border-radius: 12px;
    background-color: var(--color-canvas);
    font-weight: 400;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .inquiry-field select {
    min-height: 48px;
    padding-right: 8px;
    font-size: 14px;
  }

  .inquiry-field textarea {
    min-height: 108px;
    padding: 12px 14px;
  }

  .inquiry-field textarea::placeholder {
    line-height: 1.8;
  }

  .inquiry-field select:hover,
  .inquiry-field textarea:hover {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 45%,
      var(--color-line)
    );
  }

  .inquiry-field select:focus,
  .inquiry-field textarea:focus {
    border-color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .inquiry-preview {
    margin-top: 22px;
    padding: 17px 18px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-lavender);
  }

  .inquiry-preview-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 600;
  }

  .inquiry-contact {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 16px;
  }

  .inquiry-copy,
  .inquiry-contact-link {
    width: 100%;
    min-height: 50px;
    gap: 10px;
    border-radius: 12px;
  }

  .inquiry-copy {
    margin-top: 22px;
  }

  .inquiry-contact-link {
    margin-top: 10px;
  }

  .inquiry-note {
    margin-top: 18px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.9;
    text-align: center;
  }

  @media (max-height: 600px) {
    .inquiry-dialog[open] {
      display: block;
      overflow-y: auto;
    }

    .inquiry-form {
      overflow: visible;
    }
  }

  @media (max-width: 520px) {
    .inquiry-dialog {
      max-height: calc(100dvh - 24px);
      width: calc(100% - 24px);
      border-radius: 20px;
    }

    .inquiry-heading {
      padding: 12px 20px 18px;
    }

    .inquiry-heading-top {
      margin-bottom: 4px;
    }

    .inquiry-heading h2 {
      font-size: 24px;
    }

    .inquiry-form {
      padding: 22px 20px;
    }

    .inquiry-fields {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .inquiry-field select {
      font-size: 16px;
    }
  }
</style>
<script>
  import { initializeInquiry } from "../scripts/inquiry";
  initializeInquiry();
</script>
