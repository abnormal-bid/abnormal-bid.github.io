---
import Icon from "./Icon.astro";
import {
  products,
  serviceDurations,
  site,
  otherProduct,
  undecidedProduct,
} from "../data/site";
import { describeContact, formatInquiry, getContactLink } from "../lib/inquiry";
const initialInquiry = {
  product: undecidedProduct,
  duration: serviceDurations[0],
  notes: "",
};
const initialLink = getContactLink(site.contact, initialInquiry);
---

<dialog
  class="inquiry-dialog"
  id="inquiry-dialog"
  aria-labelledby="inquiry-title"
  aria-describedby="inquiry-description"
>
  <div class="inquiry-heading">
    <div class="inquiry-heading-top">
      <span class="inquiry-eyebrow">
        <span class="inquiry-heading-icon">
          <Icon name="chat" />
        </span>
        Let's get you started
      </span>
      <button
        class="icon-button inquiry-close"
        id="close-dialog"
        aria-label="关闭咨询窗口"
      >
        <Icon name="close" />
      </button>
    </div>
    <h2 id="inquiry-title">
      从你的需求开始<span class="text-brand">。</span>
    </h2>
    <p id="inquiry-description">
      选好服务，整理需求，再联系咨询。
      <br />
      方案、报价与开通方式均需确认后再下单。
    </p>
  </div>
  <form class="inquiry-form" id="inquiry-form">
    <div class="inquiry-fields">
      <label class="inquiry-field">
        服务类型
        <select class="mt-2" id="inquiry-product" name="product">
          {products.map(({ name }) => (
            <option>{name}</option>
          ))}
          <option>{otherProduct}</option>
          <option value={undecidedProduct} selected>
            还没想好，想先咨询
          </option>
        </select>
      </label>
      <label class="inquiry-field">
        使用时长
        <select class="mt-2" id="inquiry-duration" name="duration">
          {serviceDurations.map((value) => (
            <option>{value}</option>
          ))}
        </select>
      </label>
    </div>
    <label class="inquiry-field">
      邮箱数量、域名或客户端需求{" "}
      <span class="ml-1 text-xs font-normal text-muted-foreground">选填</span>
      <textarea
        class="mt-2"
        id="inquiry-notes"
        name="notes"
        rows="3"
        maxlength="600"
        placeholder="例如：需要 3 个邮箱，已有域名，希望在手机和电脑上收发邮件。请勿填写密码或验证码。"
      ></textarea>
    </label>
    <div class="inquiry-preview">
      <span class="inquiry-preview-label">
        <Icon name="copy" class="size-3.5" />
        你的咨询内容
      </span>
      <p
        class="mt-1 text-xs leading-loose wrap-anywhere whitespace-pre-wrap"
        id="inquiry-text"
      >
        {formatInquiry(initialInquiry)}
      </p>
    </div>
    <div class="inquiry-contact" id="contact-info">
      <Icon name="chat" class="mt-1 size-4 text-muted-foreground" />
      <p class="text-xs leading-loose wrap-anywhere text-muted-foreground">
        {describeContact(site.contact)}
      </p>
    </div>
    <button
      class="btn btn-primary inquiry-copy"
      id="copy-inquiry"
      type="submit"
    >
      <Icon name="copy" />
      复制咨询内容
    </button>
    <a
      class="btn btn-outline inquiry-contact-link"
      id="contact-link"
      href={initialLink?.href}
      hidden={!initialLink}
      rel="noopener noreferrer"
      target={initialLink?.type === "telegram" ? "_blank" : undefined}
    >
      <span data-contact-label>{initialLink?.label || "前往咨询"}</span>
      <Icon name="up-right" />
    </a>
    <p class="inquiry-note">
      此页面仅帮你整理需求，不会提交订单或扣款。
      <br />
      咨询与服务适用
      <a
        class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-current"
        href="/terms/"
        target="_blank"
        rel="noopener noreferrer"
      >
        服务条款<span class="sr-only">（新窗口打开）</span>
      </a>
      与
      <a
        class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-current"
        href="/privacy/"
        target="_blank"
        rel="noopener noreferrer"
      >
        隐私政策<span class="sr-only">（新窗口打开）</span>
      </a>
      。
    </p>
    <p
      class="mt-2 text-center text-xs leading-relaxed text-foreground empty:mt-0"
      id="copy-status"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</dialog>
<style>
  /* 对话框照 mailhq：浮层底色、24px 圆角、细边与浮层阴影，遮罩 40% 黑。 */
  .inquiry-dialog {
    width: min(560px, calc(100% - 32px));
    max-height: calc(100dvh - 40px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--popover-bg);
    color: var(--text);
    box-shadow: var(--popover-shadow);
  }

  .inquiry-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: inquiry-arrive 0.15s ease-out both;
  }

  .inquiry-dialog::backdrop {
    background: rgb(0 0 0 / 40%);
    backdrop-filter: blur(2px);
  }

  :global([data-theme="dark"]) .inquiry-dialog::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  @keyframes inquiry-arrive {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .inquiry-heading {
    flex-shrink: 0;
    border-bottom: 1px solid var(--border);
    padding: 20px 24px 22px;
  }

  .inquiry-heading-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .inquiry-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .inquiry-heading-icon {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: var(--radius-control);
    background: var(--brand);
    color: var(--brand-foreground);
  }

  .inquiry-heading-icon :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .inquiry-close {
    margin-right: -6px;
  }

  .inquiry-heading h2 {
    font-size: 24px;
    line-height: 1.3;
  }

  .inquiry-heading p {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .inquiry-form {
    min-height: 0;
    padding: 22px 24px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .inquiry-fields {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 14px;
    margin-bottom: 20px;
  }

  .inquiry-field {
    display: block;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
  }

  .inquiry-field select,
  .inquiry-field textarea {
    font-weight: 400;
  }

  .inquiry-field select {
    min-height: 40px;
    padding-right: 8px;
  }

  .inquiry-field textarea {
    min-height: 104px;
    padding: 10px 12px;
  }

  .inquiry-field textarea::placeholder {
    line-height: 1.8;
  }

  .inquiry-preview {
    margin-top: 20px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-mark);
    background: var(--surface);
  }

  .inquiry-preview-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
  }

  .inquiry-contact {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 16px;
  }

  .inquiry-copy,
  .inquiry-contact-link {
    width: 100%;
    min-height: 44px;
    gap: 8px;
  }

  .inquiry-copy :global(.icon),
  .inquiry-contact-link :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .inquiry-copy {
    margin-top: 20px;
  }

  .inquiry-contact-link {
    margin-top: 8px;
  }

  .inquiry-note {
    margin-top: 18px;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.8;
    text-align: center;
  }

  @media (max-height: 600px) {
    .inquiry-dialog[open] {
      display: block;
      overflow-y: auto;
    }

    .inquiry-form {
      overflow: visible;
    }
  }

  @media (max-width: 520px) {
    .inquiry-dialog {
      max-height: calc(100dvh - 24px);
      width: calc(100% - 24px);
    }

    .inquiry-heading {
      padding: 14px 20px 18px;
    }

    .inquiry-heading-top {
      margin-bottom: 8px;
    }

    .inquiry-heading h2 {
      font-size: 22px;
    }

    .inquiry-form {
      padding: 20px;
    }

    .inquiry-fields {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
<script>
  import { initializeInquiry } from "../scripts/inquiry";
  initializeInquiry();
</script>
