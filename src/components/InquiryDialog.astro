---
import Icon from "./Icon.astro";
import {
  products,
  subscriptionDurations,
  site,
  otherProduct,
  undecidedProduct,
} from "../data/site";
import { describeContact, formatInquiry, getContactLink } from "../lib/inquiry";
const initialInquiry = {
  product: undecidedProduct,
  duration: subscriptionDurations[0],
  notes: "",
};
const initialLink = getContactLink(site.contact, initialInquiry);
---

<dialog
  class="m-auto max-h-[calc(100dvh-40px)] w-[calc(100%-32px)] max-w-130 overscroll-contain rounded-2xl border border-[#e9e5f3] bg-surface p-5 text-ink shadow-2xl backdrop:bg-[#17102469] backdrop:backdrop-blur-sm dark:border-line dark:backdrop:bg-black/65 md:p-8"
  id="inquiry-dialog"
  aria-labelledby="inquiry-title"
  aria-describedby="inquiry-description"
>
  <div class="mb-2 flex items-center justify-between gap-4">
    <span class="eyebrow text-[0.625rem]">LET'S GET YOU STARTED</span>
    <button class="icon-button" id="close-dialog" aria-label="关闭咨询窗口">
      <Icon name="close" />
    </button>
  </div>
  <h2
    class="text-[1.625rem] leading-normal font-semibold tracking-tight"
    id="inquiry-title"
  >
    从你的需求开始<span class="text-accent">。</span>
  </h2>
  <p
    class="mt-3 mb-5 text-sm leading-loose text-muted"
    id="inquiry-description"
  >
    选好产品，整理需求，再联系咨询。
    <br />
    方案、报价与办理方式均需确认后再下单。
  </p>
  <form id="inquiry-form">
    <div class="mb-5 grid grid-cols-2 gap-3.5">
      <label class="text-sm font-medium">
        想订阅的产品
        <select class="mt-2" id="inquiry-product" name="product">
          {products.map(({ name }) => (
            <option>{name}</option>
          ))}
          <option>{otherProduct}</option>
          <option value={undecidedProduct} selected>
            还没想好，想先咨询
          </option>
        </select>
      </label>
      <label class="text-sm font-medium">
        订阅时长
        <select class="mt-2" id="inquiry-duration" name="duration">
          {subscriptionDurations.map((value) => (
            <option>{value}</option>
          ))}
        </select>
      </label>
    </div>
    <label class="block text-sm font-medium">
      套餐或其他需求{" "}
      <span class="ml-1 text-xs font-normal text-muted">选填</span>
      <textarea
        class="mt-2"
        id="inquiry-notes"
        name="notes"
        rows="3"
        maxlength="600"
        placeholder="例如：想了解个人套餐，用于写作和日常办公。请勿填写密码或验证码。"
      ></textarea>
    </label>
    <div class="mt-5 rounded-lg bg-lavender px-4 py-3.5">
      <span class="text-xs font-medium text-[#756092] dark:text-accent">
        你的咨询内容
      </span>
      <p
        class="mt-1 text-xs leading-loose wrap-anywhere whitespace-pre-wrap"
        id="inquiry-text"
      >
        {formatInquiry(initialInquiry)}
      </p>
    </div>
    <div class="mt-4 flex items-start gap-2" id="contact-info">
      <Icon name="chat" class="mt-1 size-4 text-[#8d7fa9] dark:text-accent" />
      <p class="text-xs leading-loose wrap-anywhere text-muted">
        {describeContact(site.contact)}
      </p>
    </div>
    <button
      class="btn btn-primary mt-5 w-full gap-2.5"
      id="copy-inquiry"
      type="submit"
    >
      <Icon name="copy" />
      复制咨询内容
    </button>
    <a
      class="btn btn-dark mt-2 w-full"
      id="contact-link"
      href={initialLink?.href}
      hidden={!initialLink}
      rel="noopener noreferrer"
      target={initialLink?.type === "telegram" ? "_blank" : undefined}
    >
      <span data-contact-label>{initialLink?.label || "前往咨询"}</span>
      <Icon name="up-right" />
    </a>
    <p class="mt-3 text-center text-xs leading-relaxed text-muted">
      此页面仅帮你整理需求，不会提交订单或扣款。
      <br />
      咨询与办理适用
      <a
        class="underline underline-offset-4 hover:text-accent"
        href="/terms/"
        target="_blank"
        rel="noopener noreferrer"
      >
        服务条款<span class="sr-only">（新窗口打开）</span>
      </a>
      与
      <a
        class="underline underline-offset-4 hover:text-accent"
        href="/privacy/"
        target="_blank"
        rel="noopener noreferrer"
      >
        隐私政策<span class="sr-only">（新窗口打开）</span>
      </a>
      。
    </p>
    <p
      class="mt-2 text-center text-xs leading-relaxed text-accent empty:mt-0"
      id="copy-status"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</dialog>
<script>
  import { initializeInquiry } from "../scripts/inquiry";
  initializeInquiry();
</script>
