---
import type { Product } from "../data/site";
import Icon from "./Icon.astro";
interface Props {
  product: Product;
  index: number;
}
const { product, index } = Astro.props;
const symbols = ["mail", "domain", "team", "settings"];
const symbol = symbols[index];
---

<article
  class:list={["product-card", { "is-featured": product.featured }]}
  data-product={product.name}
>
  <div class="card-top">
    <span
      class:list={["product-symbol", `symbol-${symbol}`]}
      aria-hidden="true"
    >
      {symbol === "mail" ? (
        <svg viewBox="0 0 24 24">
          <rect x="3" y="5" width="18" height="14" rx="3" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      ) : symbol === "domain" ? (
        <span>@</span>
      ) : symbol === "team" ? (
        <svg viewBox="0 0 24 24">
          <circle cx="9" cy="8" r="3" />
          <path d="M3 20v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m3 9v-2a6 6 0 0 0-2-4" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24">
          <path d="M5 4v9m0 4v3m7-16v3m0 4v9m7-16v9m0 4v3" />
          <circle cx="5" cy="15" r="2" />
          <circle cx="12" cy="9" r="2" />
          <circle cx="19" cy="15" r="2" />
        </svg>
      )}
    </span>
    <span class="product-category">{product.category}</span>
  </div>
  <h3>
    {product.name}
    <span aria-hidden="true">0{index + 1}</span>
  </h3>
  <p class="product-description">{product.description}</p>
  <div class="product-tags">
    {product.tags.map((tag) => (
      <span>
        <Icon name="check" class="size-3" />
        {tag}
      </span>
    ))}
  </div>
  <div class="product-price">
    <strong data-price>{product.price || "咨询报价"}</strong>
    <span data-price-note>{product.priceNote}</span>
  </div>
  <button
    class:list={[
      "btn product-action",
      product.featured ? "btn-primary" : "btn-outline",
    ]}
    data-inquiry={product.name}
    aria-label={`咨询这项服务：${product.name}`}
  >
    咨询这项服务 <Icon name="up-right" class="size-4" />
  </button>
</article>

<style>
  /* 服务卡片照 mailhq 的 Card：24px 圆角细边框、不铺底色；悬停只加深描边。 */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem 1.4rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--card);
    transition: border-color 0.15s;
  }
  .product-card:hover {
    border-color: color-mix(in oklab, var(--border), var(--text) 18%);
  }
  .is-featured,
  .is-featured:hover {
    border-color: color-mix(in oklab, var(--brand) 55%, var(--border));
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }
  .product-symbol {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
  }
  .product-symbol svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .is-featured .product-symbol {
    background: var(--brand);
    color: var(--brand-foreground);
  }
  .symbol-domain {
    font-size: 1.6rem;
    line-height: 1;
    font-weight: 500;
  }
  .product-category {
    padding: 2px 8px;
    border-radius: var(--radius-chip);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
  }
  h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-size: 20px;
    line-height: 1.4;
  }
  h3 > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .product-description {
    flex: 1;
    margin-top: 0.6rem;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 1.25rem;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .product-tags > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .product-tags :global(.icon) {
    color: var(--text);
  }
  .product-price {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 1.4rem;
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
  }
  .product-price strong {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .product-price > span {
    font-size: 12px;
    color: var(--text-secondary);
  }
  .product-action {
    justify-content: space-between;
    width: 100%;
    margin-top: 1.25rem;
  }
  @media (max-width: 1100px) and (min-width: 1024px) {
    .product-card {
      padding-inline: 1.1rem;
    }
    .product-tags {
      gap: 6px 10px;
    }
  }
  @media (max-width: 639px) {
    .product-card {
      padding: 1.5rem;
    }
    .product-description {
      max-width: 28rem;
    }
    h3 {
      margin-top: 1.1rem;
    }
    .product-tags {
      margin-top: 1rem;
    }
    .product-price {
      margin-top: 1.2rem;
    }
  }
</style>
