---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Start from "./Start.astro";
import Subscriptions from "./Subscriptions.astro";
import Process from "./Process.astro";
import Faq from "./Faq.astro";
import Footer from "./Footer.astro";
import InquiryDialog from "./InquiryDialog.astro";
import Icon from "./Icon.astro";
import { useCopy } from "../i18n";

/** 首页：src/pages/index.astro（中文）与 src/pages/en/index.astro（英文）共用，语言取自页面路径。 */
const { t, links } = useCopy(Astro.currentLocale);
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <div class="page-shell value-strip">
      <p>
        {t.valueStrip.lead}
        <strong>{t.valueStrip.strong}</strong>
      </p>
      <div>
        {t.valueStrip.labels.map((label) => (
          <span>
            <Icon name="spark" class="size-3.5" />
            {label}
          </span>
        ))}
      </div>
    </div>
    <Start />
    <Subscriptions />
    <Process />
    <Faq />
    <section class="page-shell closing-section" aria-labelledby="closing-title">
      <div class="closing-card">
        <div class="closing-decoration" aria-hidden="true">
          <span>@</span>
        </div>
        <div class="closing-copy">
          <p class="eyebrow">Make every connection count</p>
          <h2 id="closing-title">
            {t.closing.titleLines[0]}
            {t.space}
            <br class="closing-break" />
            {t.closing.titleLines[1]}
            {t.dot}
          </h2>
          <span>{t.closing.body}</span>
        </div>
        <div class="closing-actions">
          <a class="btn btn-primary closing-button" href={links.shop}>
            {t.closing.buy} <Icon name="arrow" class="size-4" />
          </a>
          <button class="btn btn-outline closing-button" data-inquiry>
            {t.closing.custom} <Icon name="up-right" class="size-4" />
          </button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <InquiryDialog />
</BaseLayout>

<style>
  .value-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
  }
  .value-strip p {
    font-size: 13px;
  }
  .value-strip strong {
    margin-left: 0.5rem;
    color: var(--text);
    font-weight: 500;
  }
  .value-strip > div {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .value-strip > div > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }
  .value-strip :global(.icon) {
    color: var(--brand);
  }
  .closing-section {
    padding-bottom: 5rem;
  }
  /* 收尾面板：Resend 式细边卡片，不铺底色、不加阴影，装饰只用描边色。 */
  .closing-card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    overflow: hidden;
    padding: 3rem 3.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--card);
  }
  .closing-copy {
    position: relative;
  }
  .closing-copy > h2 {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.3;
  }
  .closing-copy > span {
    display: block;
    margin-top: 0.75rem;
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
  }
  .closing-actions {
    position: relative;
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .closing-button {
    gap: 10px;
  }
  .closing-decoration {
    position: absolute;
    z-index: -1;
    width: 24rem;
    height: 24rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    left: 48%;
    top: -4rem;
    display: grid;
    place-items: center;
  }
  .closing-decoration::before {
    content: "";
    position: absolute;
    inset: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border);
  }
  .closing-decoration > span {
    font-size: 15rem;
    font-weight: 300;
    color: var(--surface);
    transform: rotate(-18deg);
    line-height: 1;
  }
  .closing-break {
    display: none;
  }
  @media (max-width: 1023px) {
    .value-strip {
      justify-content: center;
    }
    .value-strip > div {
      gap: 1.5rem;
    }
    .closing-card {
      padding: 2.75rem;
    }
  }
  @media (max-width: 767px) {
    .value-strip {
      flex-direction: column;
      gap: 1rem;
    }
    .value-strip > div {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 1.25rem;
    }
    .closing-card {
      align-items: start;
      flex-direction: column;
      gap: 1.75rem;
      padding: 2rem 1.5rem;
    }
    .closing-section {
      padding-bottom: 3.5rem;
    }
    .closing-copy > span {
      font-size: 14px;
    }
    .closing-decoration {
      left: 25%;
    }
  }
  @media (max-width: 380px) {
    .value-strip strong {
      margin-left: 0.15rem;
    }
    .closing-break {
      display: block;
    }
    .closing-copy > h2 {
      font-size: 1.6rem;
    }
  }
</style>
