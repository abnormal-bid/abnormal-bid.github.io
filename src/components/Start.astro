---
import { site } from "../data/site";
import { useCopy } from "../i18n";
import Icon from "./Icon.astro";

const { t, links } = useCopy(Astro.currentLocale);
const s = t.start;
const supportEmail = site.contact.email.trim();
---

<section class="start-section" id="start" aria-labelledby="start-title">
  <div class="page-shell section-space">
    <div class="start-heading">
      <div>
        <p class="eyebrow">
          <span>01 /</span> Start here
        </p>
        <h2 class="section-title" id="start-title">
          {s.title}
          <span class="text-signal">{t.dot}</span>
        </h2>
      </div>
      <p class="start-intro">
        {s.intro[0]}
        {t.space}
        <br class="hidden md:block" />
        {s.intro[1]}
      </p>
    </div>
    <div class="start-grid">
      {s.entries.map((entry, index) => (
        <a class:list={["start-card", { "is-primary": entry.primary }]} href={links[entry.link]}>
          <span class="start-top">
            <span class="start-icon" aria-hidden="true">
              <Icon name={entry.icon} class="size-5" />
            </span>
            <span class="start-eyebrow">{entry.eyebrow}</span>
          </span>
          <span class="start-title">
            {entry.title}
            <span aria-hidden="true">0{index + 1}</span>
          </span>
          <span class="start-description">{entry.description}</span>
          <span class="start-action">
            {entry.action}
            <Icon name="up-right" class="size-4" />
          </span>
        </a>
      ))}
    </div>
    <div class="start-more">
      {s.secondary.map(({ link, label }) => (
        <a class="text-link" href={links[link]}>
          {label} <Icon name="up-right" class="size-3.5" />
        </a>
      ))}
      {supportEmail && (
        <a class="text-link" href={`mailto:${supportEmail}`}>
          {s.support} {supportEmail}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .start-section {
    border-top: 1px solid var(--border);
  }
  .start-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .eyebrow > span {
    margin-right: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .start-intro {
    padding-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }
  .start-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  /* 入口卡片照服务卡片：24px 圆角细边框、不铺底色；整张卡片是链接，悬停只加深描边。 */
  .start-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem 1.4rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--card);
    transition: border-color 0.15s;
  }
  .start-card:hover {
    border-color: color-mix(in oklab, var(--border), var(--text) 18%);
  }
  .start-card.is-primary,
  .start-card.is-primary:hover {
    border-color: color-mix(in oklab, var(--brand) 55%, var(--border));
  }
  .start-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }
  .start-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
  }
  .is-primary .start-icon {
    background: var(--highlight);
    color: var(--highlight-foreground);
  }
  .start-eyebrow {
    padding: 2px 8px;
    border-radius: var(--radius-chip);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
  }
  .start-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .start-title > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .start-description {
    flex: 1;
    margin-top: 0.6rem;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.8;
  }
  .start-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 14px;
    font-weight: 500;
  }
  .start-action :global(.icon) {
    color: var(--text-secondary);
    transition: color 0.15s;
  }
  .start-card:hover .start-action :global(.icon) {
    color: var(--text);
  }
  .is-primary .start-action :global(.icon) {
    color: var(--brand);
  }
  .start-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.75rem;
  }
  .start-more > a {
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 1023px) {
    .start-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .start-heading {
      gap: 1rem;
    }
  }
  @media (max-width: 767px) {
    .start-heading {
      align-items: start;
      flex-direction: column;
      margin-bottom: 1.75rem;
    }
  }
  @media (max-width: 639px) {
    .start-grid {
      grid-template-columns: 1fr;
    }
    .start-card {
      padding: 1.5rem;
    }
    .start-title {
      margin-top: 1.1rem;
    }
  }
</style>
