---
import Icon from "./Icon.astro";
const options = [
  { value: "system", label: "跟随系统", icon: "monitor" },
  { value: "light", label: "浅色模式", icon: "sun" },
  { value: "dark", label: "深色模式", icon: "moon" },
] as const;
---

<details class="theme-picker" data-theme-picker>
  <summary
    class="icon-button theme-toggle"
    aria-label="切换主题，当前跟随系统"
    title="主题：跟随系统"
  >
    {options.map(({ value, icon }) => (
      <span data-theme-icon={value} hidden={value !== "system"}>
        <Icon name={icon} />
      </span>
    ))}
  </summary>
  <fieldset class="theme-menu">
    <legend class="sr-only">外观主题</legend>
    <div class="theme-menu-title" aria-hidden="true">
      外观主题
    </div>
    {options.map(({ value, label, icon }) => (
      <label class="theme-option">
        <input
          class="peer sr-only"
          type="radio"
          name="theme"
          value={value}
          checked={value === "system"}
        />
        <Icon name={icon} class="size-4" />
        <span>{label}</span>
        <Icon name="check" class="theme-check ml-auto size-3.5" />
      </label>
    ))}
  </fieldset>
</details>
<style>
  .theme-picker {
    position: relative;
  }

  .theme-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface);
    list-style: none;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .theme-toggle:hover,
  .theme-picker[open] .theme-toggle {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 40%,
      var(--color-line)
    );
    background: var(--color-lavender);
    color: var(--color-accent);
  }

  .theme-menu {
    position: absolute;
    z-index: 60;
    top: calc(100% + 12px);
    right: 0;
    width: 184px;
    max-height: calc(100dvh - 86px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 7px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: 0 12px 40px rgb(0 0 0 / 10%);
  }

  .theme-menu-title {
    padding: 7px 11px 9px;
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .theme-option {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 11px;
    padding: 10px 11px;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--color-muted);
    font-size: 13px;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .theme-option + .theme-option {
    margin-top: 3px;
  }

  .theme-option:hover {
    background: var(--color-subtle);
    color: var(--color-ink);
  }

  .theme-option:has(input:checked) {
    border-color: var(--color-line);
    background: var(--color-lavender);
    color: var(--color-accent);
    font-weight: 600;
  }

  .theme-option:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-option :global(.theme-check) {
    opacity: 0;
  }

  .theme-option:has(input:checked) :global(.theme-check) {
    opacity: 1;
  }
</style>
<script>
  import { initializeThemePicker } from "../scripts/theme";
  initializeThemePicker();
</script>
