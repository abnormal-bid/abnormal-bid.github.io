---
import Icon from "./Icon.astro";
const options = [
  { value: "system", label: "跟随系统", icon: "monitor" },
  { value: "light", label: "浅色模式", icon: "sun" },
  { value: "dark", label: "深色模式", icon: "moon" },
] as const;
---

<details class="theme-picker" data-theme-picker>
  <summary
    class="icon-button theme-toggle"
    aria-label="切换主题，当前跟随系统"
    title="主题：跟随系统"
  >
    {options.map(({ value, icon }) => (
      <span data-theme-icon={value} hidden={value !== "system"}>
        <Icon name={icon} />
      </span>
    ))}
  </summary>
  <fieldset class="theme-menu">
    <legend class="sr-only">外观主题</legend>
    <div class="theme-menu-title" aria-hidden="true">
      外观主题
    </div>
    {options.map(({ value, label, icon }) => (
      <label class="theme-option">
        <input
          class="peer sr-only"
          type="radio"
          name="theme"
          value={value}
          checked={value === "system"}
        />
        <Icon name={icon} class="size-4" />
        <span>{label}</span>
        <Icon name="check" class="theme-check ml-auto size-3.5" />
      </label>
    ))}
  </fieldset>
</details>
<style>
  .theme-picker {
    position: relative;
  }

  .theme-toggle {
    list-style: none;
  }

  .theme-picker[open] .theme-toggle {
    background: var(--control);
    color: var(--text);
  }

  /* 浮层照 mailhq 的菜单：白底（深色 #262624）、16px 圆角、浮层阴影。 */
  .theme-menu {
    position: absolute;
    z-index: 60;
    top: calc(100% + 8px);
    right: 0;
    width: 176px;
    max-height: calc(100dvh - 80px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius-mark);
    background: var(--popover-bg);
    box-shadow: var(--popover-shadow);
  }

  .theme-menu-title {
    padding: 6px 10px 4px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
  }

  .theme-option {
    display: flex;
    min-height: 36px;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .theme-option:hover {
    background: var(--hover);
    color: var(--text);
  }

  .theme-option:has(input:checked) {
    color: var(--text);
    font-weight: 500;
  }

  .theme-option:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .theme-option :global(.theme-check) {
    opacity: 0;
  }

  .theme-option:has(input:checked) :global(.theme-check) {
    opacity: 1;
  }
</style>
<script>
  import { initializeThemePicker } from "../scripts/theme";
  initializeThemePicker();
</script>
