---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { legalPages, site } from "../data/site";

const supportEmail = site.contact.email.trim();
---

<footer class="site-footer">
  <div class="page-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <Brand />
        <p class="footer-tagline">Your inbox. Your identity.</p>
      </div>
      <div class="footer-service">
        <p class="footer-label">为每一次联系，找到合适的开始。</p>
        <a class="text-link" href="/#services">
          探索邮箱服务 <Icon name="up-right" class="size-4" />
        </a>
      </div>
      <div class="footer-contact">
        <p class="footer-label">保持联系 / CONTACT</p>
        {supportEmail && (
          <a
            class="footer-email"
            href={`mailto:${supportEmail}`}
            aria-label={`客服邮箱：${supportEmail}`}
          >
            {supportEmail}
          </a>
        )}
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Abnormal. 让沟通更简单。</span>
      <div class="footer-meta">
        <p>邮箱服务与配置支持 · 具体方案以咨询确认为准</p>
        <nav class="footer-legal" aria-label="法律信息">
          {legalPages.map(({ href, label }) => (
            <a class="transition-colors hover:text-accent" href={href}>
              {label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 1rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-subtle);
  }
  .footer-main {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
  }
  .footer-tagline {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.035em;
    color: var(--color-muted);
  }
  .footer-label {
    margin-bottom: 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.8;
    color: var(--color-muted);
  }
  .footer-email {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.4em;
    transition: color 180ms ease;
  }
  .footer-email:hover {
    color: var(--color-accent);
  }
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.8;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-legal {
    display: flex;
    gap: 1.25rem;
  }
  @media (width >= 768px) {
    .footer-main {
      grid-template-columns: 1.1fr 1fr 0.9fr;
      align-items: center;
      gap: 2rem;
      padding-block: 3.5rem;
    }
    .footer-contact {
      justify-self: end;
    }
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }
    .footer-meta {
      align-items: flex-end;
    }
  }
  @media (width >= 1100px) {
    .footer-meta {
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
    }
  }
</style>
