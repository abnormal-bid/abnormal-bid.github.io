---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { legalPages, site } from "../data/site";

const supportEmail = site.contact.email.trim();
---

<footer class="page-shell">
  <div class="flex flex-wrap items-center justify-between gap-4 pb-7 md:gap-6">
    <Brand />
    <span class="order-3 w-full text-xs tracking-wide text-muted md:order-none md:w-auto">
      Your inbox. Your identity.
    </span>
    <div class="flex flex-col items-end gap-3">
      {supportEmail && (
        <a
          class="text-sm text-muted hover:text-accent"
          href={`mailto:${supportEmail}`}
          aria-label={`客服邮箱：${supportEmail}`}
        >
          {supportEmail}
        </a>
      )}
      <a
        class="inline-flex items-center gap-2 text-xs text-muted hover:text-accent"
        href="/#services"
      >
        探索邮箱服务 <Icon name="up-right" class="size-3.5" />
      </a>
    </div>
  </div>
  <div class="flex flex-col justify-between gap-3 border-t border-line py-6 text-[0.6875rem] leading-relaxed text-muted md:flex-row md:gap-5 md:text-xs">
    <span>© {new Date().getFullYear()} Abnormal. 让沟通更简单。</span>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-5">
      <p>邮箱服务与配置支持 · 具体方案以咨询确认为准</p>
      <nav class="flex gap-4" aria-label="法律信息">
        {legalPages.map(({ href, label }) => (
          <a class="transition-colors hover:text-accent" href={href}>
            {label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
