---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { useCopy } from "../i18n";

const { t, links, path } = useCopy(Astro.currentLocale);
const f = t.footer;
const productLinks = f.productLinks.map(({ link, label }) => ({
  href: links[link],
  label,
}));
const supportLinks = [
  ...f.supportLinks.map(({ link, label }) => ({ href: links[link], label })),
  { href: path("/#faq"), label: f.faq },
];
const supportEmail = site.contact.email.trim();
---

<footer class="site-footer">
  <div class="page-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <Brand />
        <p class="footer-tagline">Your inbox. Your identity.</p>
      </div>
      <nav class="footer-links" aria-label={f.productLabel}>
        <p class="footer-label">{f.productLabel}</p>
        <ul>
          {productLinks.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav class="footer-links" aria-label={f.supportLabel}>
        <p class="footer-label">{f.supportLabel}</p>
        <ul>
          {supportLinks.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="footer-contact">
        <p class="footer-label">{f.contactLabel}</p>
        {supportEmail && (
          <a class="footer-email" href={`mailto:${supportEmail}`} aria-label={f.emailAria(supportEmail)}>
            {supportEmail}
          </a>
        )}
      </div>
    </div>
    <div class="footer-bottom">
      <span>{f.copyright(new Date().getFullYear())}</span>
      <div class="footer-meta">
        <p>
          <a class="footer-cta" href={links.shop}>
            {f.buyOnline} <Icon name="up-right" class="size-3.5" />
          </a>
        </p>
        <nav class="footer-legal" aria-label={f.legalLabel}>
          {t.legalPages.map(({ path: page, label }) => (
            <a class="transition-colors hover:text-foreground" href={path(page)}>
              {label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .footer-main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 2.5rem;
  }
  .footer-brand,
  .footer-contact {
    grid-column: 1 / -1;
  }
  .footer-tagline {
    margin-top: 1rem;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .footer-label {
    margin-bottom: 0.75rem;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .footer-links ul {
    display: grid;
    gap: 0.5rem;
  }
  .footer-links a,
  .footer-cta {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 0.15s;
  }
  .footer-links a:hover,
  .footer-cta:hover {
    color: var(--text);
  }
  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .footer-email {
    font-size: 15px;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s;
  }
  .footer-email:hover {
    text-decoration-color: currentColor;
  }
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.7;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-legal {
    display: flex;
    gap: 1.25rem;
  }
  @media (width >= 768px) {
    .footer-main {
      grid-template-columns: 1.3fr 0.8fr 0.8fr 1fr;
      align-items: start;
      gap: 2rem;
      padding-block: 3.5rem;
    }
    .footer-brand,
    .footer-contact {
      grid-column: auto;
    }
    .footer-contact {
      justify-self: end;
    }
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }
    .footer-meta {
      align-items: flex-end;
    }
  }
  @media (width >= 1100px) {
    .footer-meta {
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
    }
  }
</style>
