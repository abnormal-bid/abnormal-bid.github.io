---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";

const supportEmail = site.contact.email.trim();
---

<footer class="page-shell">
  <div class="flex flex-wrap items-center justify-between gap-4 pb-7 md:gap-6">
    <Brand />
    <span class="order-3 w-full text-xs tracking-wide text-muted md:order-none md:w-auto">
      Stay curious. Be abnormal.
    </span>
    <div class="flex flex-col items-end gap-3">
      {supportEmail && (
        <a
          class="text-sm text-muted hover:text-brand"
          href={`mailto:${supportEmail}`}
          aria-label={`客服邮箱：${supportEmail}`}
        >
          {supportEmail}
        </a>
      )}
      <a
        class="inline-flex items-center gap-2 text-xs text-muted hover:text-brand"
        href="#subscriptions"
      >
        探索订阅 <Icon name="up-right" class="size-3.5" />
      </a>
    </div>
  </div>
  <div class="flex flex-col justify-between gap-2 border-t border-line py-6 text-[0.6875rem] leading-relaxed text-muted md:flex-row md:gap-5 md:text-xs">
    <span>© {new Date().getFullYear()} Abnormal. 保持好奇，创造不同。</span>
    <p>独立订阅代办服务 · 所列产品名称及商标归各自权利人所有</p>
  </div>
</footer>
