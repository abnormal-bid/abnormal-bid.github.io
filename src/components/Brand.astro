---
import { useCopy } from "../i18n";
const { t, path } = useCopy(Astro.currentLocale);
---

<a class="brand" href={path("/")} aria-label={t.brandLabel}>
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" fill="#ffe14d" />
    <path
      d="M21.4 36 21.09 33.92Q20.26 35.01 19.14 35.59Q18.01 36.18 16.16 36.18Q14.38 36.18 13.09 35.58Q11.8 34.99 11.1 33.92Q10.4 32.85 10.4 31.41Q10.4 29.27 11.97 27.83Q13.55 26.39 16.62 26.05L21.09 25.55V24.25Q21.09 23.42 20.36 22.76Q19.63 22.09 18.08 22.09Q16.72 22.09 15.71 22.76Q14.71 23.42 14.37 24.74L11.03 23.51Q11.69 21.27 13.61 20.01Q15.52 18.76 18.28 18.76Q21.6 18.76 23.27 20.42Q24.93 22.08 24.93 24.67V36ZM21.09 28.52 16.99 29.04Q15.7 29.21 15.06 29.77Q14.41 30.34 14.41 31.17Q14.41 31.97 15.03 32.51Q15.65 33.06 16.76 33.06Q18.16 33.06 19.13 32.56Q20.1 32.07 20.59 31.11Q21.09 30.15 21.09 28.76Z"
      fill="#f7f7f4"
      transform="translate(2.2 0)"
    />
    <path
      d="M21.4 36 21.09 33.92Q20.26 35.01 19.14 35.59Q18.01 36.18 16.16 36.18Q14.38 36.18 13.09 35.58Q11.8 34.99 11.1 33.92Q10.4 32.85 10.4 31.41Q10.4 29.27 11.97 27.83Q13.55 26.39 16.62 26.05L21.09 25.55V24.25Q21.09 23.42 20.36 22.76Q19.63 22.09 18.08 22.09Q16.72 22.09 15.71 22.76Q14.71 23.42 14.37 24.74L11.03 23.51Q11.69 21.27 13.61 20.01Q15.52 18.76 18.28 18.76Q21.6 18.76 23.27 20.42Q24.93 22.08 24.93 24.67V36ZM21.09 28.52 16.99 29.04Q15.7 29.21 15.06 29.77Q14.41 30.34 14.41 31.17Q14.41 31.97 15.03 32.51Q15.65 33.06 16.76 33.06Q18.16 33.06 19.13 32.56Q20.1 32.07 20.59 31.11Q21.09 30.15 21.09 28.76Z"
      fill="#141412"
    />
    <path
      d="M28 21 37.8 11.2M30.5 10H39v8.5"
      fill="none"
      stroke="#141412"
      stroke-width="3.2"
      stroke-linecap="square"
      stroke-linejoin="miter"
    ></path>
  </svg>
  <span>
    abnormal<span class="brand-period">.</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-control);
    font-size: 17px;
    line-height: 1;
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  /*
   * 品牌标记与 mailhq 的 BrandMark 同一幅图：荧光黄方块上一个墨色小写 a，带纸白色错位影子和右上箭头。
   * 颜色是固定的品牌色，两种主题都不变；public/favicon.svg 也是同一幅图。
   */
  .brand-mark {
    display: block;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-chip);
  }
  .brand-period {
    color: var(--brand);
  }
</style>
