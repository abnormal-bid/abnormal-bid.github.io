---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import ThemePicker from "./ThemePicker.astro";
import { navigation } from "../data/site";
---

<header class="site-header">
  <div class="page-shell header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <ThemePicker />
      <span class="header-divider" aria-hidden="true"></span>
      <button class="btn btn-primary header-inquiry" data-inquiry>
        咨询邮箱 <Icon name="up-right" class="size-3.5" />
      </button>
      <button
        class="menu-toggle icon-button"
        aria-label="展开导航"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="移动端导航" hidden>
    <div class="page-shell mobile-nav-inner">
      {navigation.map(({ href, label }, index) => (
        <a href={href}>
          <span>0{index + 1}</span>
          {label}
          <Icon name="up-right" class="size-4" />
        </a>
      ))}
      <button class="btn btn-primary" data-inquiry>
        咨询邮箱 <Icon name="up-right" class="size-4" />
      </button>
    </div>
  </nav>
</header>
<script>
  import { initializeNavigation } from "../scripts/navigation";
  initializeNavigation();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }
  /* 导航照 mailhq 的幽灵按钮：灰字，悬停铺半透明底。 */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 24px;
    margin-right: auto;
  }
  .desktop-nav a {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding: 0 10px;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 14px;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .desktop-nav a:hover {
    background: var(--control);
    color: var(--text);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .header-divider {
    width: 1px;
    height: 16px;
    margin-inline: 8px;
    background: var(--border);
  }
  .header-inquiry {
    min-height: 32px;
    padding: 0 12px;
    gap: 6px;
  }
  .menu-toggle {
    display: none;
  }
  #mobile-nav {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    max-height: calc(100dvh - 65px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding-block: 8px 20px;
  }
  .mobile-nav-inner > a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .mobile-nav-inner > a > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mobile-nav-inner > a :global(.icon) {
    margin-left: auto;
    color: var(--text-secondary);
  }
  .mobile-nav-inner > button {
    margin-top: 16px;
  }
  @media (min-width: 768px) {
    #mobile-nav {
      display: none;
    }
  }
  @media (max-width: 950px) {
    .desktop-nav {
      margin-left: 8px;
    }
  }
  @media (max-width: 767px) {
    .header-inner {
      gap: 12px;
    }
    .desktop-nav,
    .header-divider {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .header-inquiry {
      display: none;
    }
  }
</style>
