---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import ThemePicker from "./ThemePicker.astro";
import { switchPath, useCopy } from "../i18n";
const { lang, t, links, path } = useCopy(Astro.currentLocale);
const other = lang === "zh" ? "en" : "zh";
const otherHtmlLang = other === "en" ? "en" : "zh-CN";
const nav = t.header.nav.map(({ anchor, label }) => ({
  href: path(`/#${anchor}`),
  label,
}));
---

<header class="site-header">
  <div class="page-shell header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label={t.header.navLabel}>
      {nav.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a
        class="lang-toggle"
        href={switchPath(Astro.url.pathname, other)}
        hreflang={otherHtmlLang}
        lang={otherHtmlLang}
        aria-label={t.langToggle.aria}
        title={t.langToggle.aria}
      >
        {t.langToggle.label}
      </a>
      <ThemePicker />
      <span class="header-divider" aria-hidden="true"></span>
      <a class="header-login" href={links.webmail}>
        {t.header.login}
      </a>
      <a class="btn btn-primary header-cta" href={links.shop}>
        {t.header.buy} <Icon name="up-right" class="size-3.5" />
      </a>
      <button
        class="menu-toggle icon-button"
        aria-label={t.header.openMenu}
        data-open-label={t.header.openMenu}
        data-close-label={t.header.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label={t.header.mobileNavLabel} hidden>
    <div class="page-shell mobile-nav-inner">
      {nav.map(({ href, label }, index) => (
        <a href={href}>
          <span>0{index + 1}</span>
          {label}
          <Icon name="up-right" class="size-4" />
        </a>
      ))}
      <div class="mobile-nav-actions">
        <a class="btn btn-primary" href={links.shop}>
          {t.header.buy} <Icon name="up-right" class="size-4" />
        </a>
        <a class="btn btn-outline" href={links.redeem}>
          {t.header.haveCode} <Icon name="up-right" class="size-4" />
        </a>
        <a class="btn btn-outline" href={links.webmail}>
          {t.header.loginWebmail} <Icon name="up-right" class="size-4" />
        </a>
      </div>
    </div>
  </nav>
</header>
<script>
  import { initializeNavigation } from "../scripts/navigation";
  initializeNavigation();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }
  /* 导航照 mailhq 的幽灵按钮：灰字，悬停铺半透明底。 */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 24px;
    margin-right: auto;
  }
  .desktop-nav a {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding: 0 10px;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 14px;
    white-space: nowrap;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .desktop-nav a:hover {
    background: var(--control);
    color: var(--text);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .header-divider {
    width: 1px;
    height: 16px;
    margin-inline: 8px;
    background: var(--border);
  }
  /* 语言切换照 onboard：幽灵按钮，显示另一种语言的简称。 */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .lang-toggle:hover {
    background: var(--control);
    color: var(--text);
  }
  .header-login {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding: 0 10px;
    margin-right: 4px;
    border-radius: var(--radius-control);
    white-space: nowrap;
    color: var(--text-secondary);
    font-size: 14px;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .header-login:hover {
    background: var(--control);
    color: var(--text);
  }
  .header-cta {
    min-height: 32px;
    padding: 0 12px;
    gap: 6px;
    white-space: nowrap;
  }
  .menu-toggle {
    display: none;
  }
  #mobile-nav {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    max-height: calc(100dvh - 65px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding-block: 8px 20px;
  }
  .mobile-nav-inner > a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .mobile-nav-inner > a > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mobile-nav-inner > a :global(.icon) {
    margin-left: auto;
    color: var(--text-secondary);
  }
  .mobile-nav-actions {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }
  @media (min-width: 768px) {
    #mobile-nav {
      display: none;
    }
  }
  @media (max-width: 950px) {
    .desktop-nav {
      margin-left: 8px;
    }
    .desktop-nav a {
      padding: 0 8px;
    }
    /* 窄一点的平板宽度放不下全部入口：「登录邮箱」让给首屏与页脚的入口。 */
    .header-login {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .header-inner {
      gap: 12px;
    }
    .desktop-nav,
    .header-divider {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .header-login,
    .header-cta {
      display: none;
    }
  }
</style>
