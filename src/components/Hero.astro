---
import Icon from "./Icon.astro";
const promises = ["费用提前确认", "按需选择方案", "专人协助配置"];
---

<section class="page-shell hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-eyebrow">
      <span aria-hidden="true"></span> EMAIL, MADE PERSONAL
    </p>
    <h1 id="hero-title">
      好用的邮箱，
      <br />
      <span class="hero-title-accent">
        沟通更简单<span class="hero-period">。</span>
      </span>
    </h1>
    <p class="hero-description">
      一个邮箱，连接日常与工作。
      <br />
      从个人收发到团队协作，找到适合你的邮箱方案。
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/#services">
        探索邮箱服务 <Icon name="arrow" class="size-4" />
      </a>
      <a class="text-link" href="#how-it-works">
        了解服务流程 <Icon name="up-right" class="size-4" />
      </a>
    </div>
    <div class="hero-promises">
      {promises.map((promise) => (
        <span>
          <Icon name="check" class="size-3.5" />
          {promise}
        </span>
      ))}
    </div>
  </div>

  <div
    class="hero-visual"
    role="img"
    aria-label="邮箱服务概念示意：清晰的收件箱和专属域名地址，连接日常与工作。"
  >
    <div class="visual-orbit" aria-hidden="true"></div>
    <span class="visual-plus plus-one" aria-hidden="true">
      +
    </span>
    <span class="visual-plus plus-two" aria-hidden="true">
      +
    </span>
    <div class="identity-note" aria-hidden="true">
      <span class="note-brand">
        a<Icon name="up-right" />
      </span>
      <span>
        GOOD MAIL.
        <br />
        GOOD DAYS.
      </span>
      <span class="note-flower">✳</span>
    </div>
    <div class="inbox-window" aria-hidden="true">
      <div class="window-chrome">
        <span class="window-dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>YOUR EVERYDAY INBOX</span>
        <Icon name="shield" class="size-3.5" />
      </div>
      <div class="inbox-body">
        <div class="inbox-heading">
          <div>
            <span class="inbox-overline">A LITTLE MORE CONNECTED</span>
            <p>
              每一封，都有归处<span>。</span>
            </p>
          </div>
          <span class="inbox-avatar">a.</span>
        </div>
        <div class="inbox-tabs">
          <span>
            收件箱 <b>03</b>
          </span>
          <span>星标邮件</span>
          <Icon name="plus" class="size-4" />
        </div>
        <div class="mail-row">
          <span class="mail-avatar avatar-sage">
            <Icon name="spark" />
          </span>
          <div>
            <strong>新的连接，新的可能。</strong>
            <span>让每一次沟通，都成为美好的开始。</span>
          </div>
          <span class="mail-time">
            09:41<span class="unread-dot"></span>
          </span>
        </div>
        <div class="mail-row">
          <span class="mail-avatar avatar-peach">
            <Icon name="chat" />
          </span>
          <div>
            <strong>关于我们的下一个计划</strong>
            <span>灵感、想法，还有期待已久的好消息。</span>
          </div>
          <span class="mail-time">昨天</span>
        </div>
        <div class="mail-row last-mail">
          <span class="mail-avatar avatar-stone">
            <Icon name="check" />
          </span>
          <div>
            <strong>一切就绪，开始吧。</strong>
            <span>你的日常，从一个顺手的邮箱开始。</span>
          </div>
          <span class="mail-time">昨天</span>
        </div>
      </div>
    </div>
    <div class="domain-note" aria-hidden="true">
      <span class="domain-at">@</span>
      <div>
        <span>你的名字，就是你的地址</span>
        <strong>
          hello@<span>yourname</span>.com
        </strong>
      </div>
      <span class="domain-check">
        <Icon name="check" class="size-3.5" />
      </span>
    </div>
    <p class="visual-caption" aria-hidden="true">
      <span></span> YOUR INBOX. YOUR IDENTITY.{" "}
      <span class="demo-label">概念示意</span>
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: 5rem 4.5rem;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: 99px;
    color: var(--color-accent);
    background: var(--color-subtle);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .hero-eyebrow > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  h1 {
    margin-block: 1.6rem 1.4rem;
    font-size: clamp(2.4rem, 4.45vw, 4rem);
    line-height: 1.38;
    font-weight: 650;
    letter-spacing: -0.06em;
  }
  .hero-title-accent {
    position: relative;
    color: var(--color-accent);
  }
  .hero-title-accent::after {
    content: "";
    position: absolute;
    bottom: -0.08em;
    left: 0;
    width: 85%;
    height: 0.08em;
    background: var(--color-lime);
    border-radius: 50%;
    transform: rotate(-1.5deg);
  }
  .hero-period {
    margin-left: -0.12em;
  }
  .hero-description {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 2;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.7rem;
    margin-top: 1.9rem;
  }
  .hero-actions .btn {
    min-height: 3.2rem;
  }
  .hero-actions .text-link {
    font-size: 0.8rem;
  }
  .hero-promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 1.6rem;
    font-size: 0.65rem;
    color: var(--color-muted);
  }
  .hero-promises > span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .hero-promises :global(.icon) {
    color: var(--color-accent);
  }
  .hero-visual {
    position: relative;
    min-width: 0;
    height: 475px;
    isolation: isolate;
    background-image: radial-gradient(
      var(--color-line) 0.8px,
      transparent 0.8px
    );
    background-size: 18px 18px;
  }
  .hero-visual::before {
    content: "";
    position: absolute;
    inset: 6% 1% 4% 5%;
    border-radius: 50%;
    background: var(--color-lavender);
    z-index: -1;
  }
  .visual-orbit {
    position: absolute;
    inset: 0;
    border: 1px dashed var(--color-line);
    border-radius: 50%;
  }
  .inbox-window {
    position: absolute;
    top: 20%;
    left: 1%;
    width: 91%;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    box-shadow:
      0 24px 55px -22px #21392935,
      0 3px 10px #21392906;
    transform: rotate(-3deg);
    overflow: hidden;
    transition: transform 0.4s;
  }
  .hero-visual:hover .inbox-window {
    transform: rotate(-1deg) translateY(-4px);
  }
  .window-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.45rem;
    letter-spacing: 0.13em;
  }
  .window-dots {
    display: flex;
    gap: 4px;
  }
  .window-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-line);
  }
  .window-dots i:first-child {
    background: #b7cba1;
  }
  .inbox-body {
    padding: 1.4rem 1.4rem 0.5rem;
  }
  .inbox-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .inbox-overline {
    font-size: 0.45rem;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .inbox-heading p {
    margin-top: 0.35rem;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.05em;
  }
  .inbox-heading p > span {
    color: var(--color-accent);
  }
  .inbox-avatar {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: var(--color-lime);
    color: #244c3e;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.06em;
  }
  .inbox-tabs {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin-top: 1.4rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.65rem;
    color: var(--color-muted);
  }
  .inbox-tabs > span {
    padding-bottom: 0.7rem;
  }
  .inbox-tabs > span:first-child {
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-accent);
  }
  .inbox-tabs b {
    margin-left: 0.25rem;
    border-radius: 4px;
    background: var(--color-lavender);
    padding: 0.15rem 0.25rem;
    font-size: 0.5rem;
  }
  .inbox-tabs :global(.icon) {
    margin: 0 0 0.7rem auto;
  }
  .mail-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-line);
  }
  .last-mail {
    border-bottom: 0;
  }
  .mail-avatar {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 9px;
  }
  .mail-avatar :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .avatar-sage {
    background: #eaf0dc;
    color: #577249;
  }
  .avatar-peach {
    background: #f7e9dd;
    color: #a47b5a;
  }
  .avatar-stone {
    background: #edf0eb;
    color: #6f7a70;
  }
  .mail-row > div {
    min-width: 0;
  }
  .mail-row strong {
    display: block;
    font-size: 0.65rem;
    font-weight: 500;
  }
  .mail-row > div > span {
    display: block;
    margin-top: 3px;
    font-size: 0.5rem;
    color: var(--color-muted);
  }
  .mail-time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    margin-left: auto;
    align-self: start;
    padding-top: 0.2rem;
    font-size: 0.45rem;
    color: var(--color-muted);
  }
  .unread-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .identity-note {
    position: absolute;
    top: 0;
    right: 1%;
    z-index: 2;
    width: 125px;
    height: 143px;
    padding: 1rem;
    border-radius: 9px;
    background: #244c3e;
    color: #d8ecaa;
    transform: rotate(10deg);
    box-shadow: 0 14px 25px -16px #143a3855;
  }
  .note-brand {
    display: flex;
    align-items: start;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    font-size: 2rem;
    line-height: 1;
    font-weight: 600;
  }
  .note-brand :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .identity-note > span:nth-child(2) {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .note-flower {
    position: absolute;
    bottom: 0.6rem;
    right: 0.7rem;
    font-size: 1.3rem;
  }
  .domain-note {
    position: absolute;
    z-index: 3;
    bottom: 0.25rem;
    left: 7%;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: 0 12px 30px -12px #244c3e22;
    transform: rotate(2deg);
  }
  .domain-at {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--color-lavender);
    color: var(--color-accent);
    font-size: 1.4rem;
  }
  .domain-note > div > span {
    font-size: 0.55rem;
    color: var(--color-muted);
  }
  .domain-note strong {
    display: block;
    margin-top: 1px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .domain-note strong > span {
    color: var(--color-accent);
  }
  .domain-check {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-left: 0.25rem;
    border-radius: 50%;
    background: var(--color-lime);
    color: #244c3e;
  }
  .visual-caption {
    position: absolute;
    bottom: -2rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }
  .visual-caption > span:first-child {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .demo-label {
    padding-left: 0.5rem;
    border-left: 1px solid var(--color-line);
    letter-spacing: 0.05em;
  }
  .visual-plus {
    position: absolute;
    color: var(--color-accent);
    font-weight: 300;
    font-size: 1.4rem;
  }
  .plus-one {
    top: 6%;
    left: 13%;
  }
  .plus-two {
    bottom: 1%;
    right: 5%;
  }
  :global([data-theme="dark"]) .inbox-window {
    box-shadow: 0 24px 55px -22px #0008;
  }
  :global([data-theme="dark"]) .mail-avatar {
    background: var(--color-lavender);
    color: var(--color-accent);
  }
  @media (min-width: 1440px) {
    .hero {
      padding-block: 5.5rem 5rem;
      gap: 4rem;
    }
  }
  @media (max-width: 1000px) and (min-width: 768px) {
    .hero {
      gap: 1rem;
      padding-block: 3.75rem;
    }
    h1 {
      font-size: 2.5rem;
    }
    .hero-description {
      font-size: 0.8rem;
    }
    .hero-actions {
      gap: 1rem;
    }
    .hero-actions .btn {
      padding-inline: 1.1rem;
    }
    .hero-visual {
      height: 450px;
    }
    .inbox-body {
      padding: 1rem 1rem 0.3rem;
    }
    .inbox-heading p {
      font-size: 1rem;
    }
    .inbox-window {
      top: 19%;
      width: 98%;
    }
    .mail-row > div > span {
      max-width: 155px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .domain-note {
      left: 0;
      padding: 0.7rem;
      gap: 0.5rem;
    }
    .domain-note strong {
      font-size: 0.85rem;
    }
    .identity-note {
      width: 108px;
      height: 125px;
      right: 2%;
    }
  }
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-block: 2.8rem 3.5rem;
    }
    .hero-copy {
      text-align: center;
    }
    h1 {
      font-size: clamp(2.35rem, 8.2vw, 3.6rem);
      margin-block: 1.5rem;
    }
    .hero-description {
      font-size: 0.82rem;
    }
    .hero-actions,
    .hero-promises {
      justify-content: center;
    }
    .hero-actions {
      gap: 1.5rem;
    }
    .hero-promises {
      gap: 0.8rem;
    }
    .hero-visual {
      width: min(100%, 470px);
      height: 445px;
      margin-inline: auto;
    }
    .inbox-window {
      left: 0;
      width: 94%;
      top: 14%;
    }
    .identity-note {
      top: -0.5rem;
      right: 2%;
      width: 110px;
      height: 127px;
    }
    .domain-note {
      bottom: 0;
      left: 5%;
    }
  }
  @media (max-width: 380px) {
    .hero {
      padding-top: 2.3rem;
      gap: 2.5rem;
    }
    .hero-description {
      font-size: 0.75rem;
    }
    .hero-actions {
      gap: 1rem;
    }
    .hero-actions .btn {
      padding-inline: 1.2rem;
    }
    .hero-actions .text-link {
      font-size: 0.75rem;
    }
    .hero-promises {
      gap: 0.5rem;
      font-size: 0.6rem;
    }
    .hero-visual {
      height: 425px;
    }
    .inbox-body {
      padding: 1rem 0.85rem 0.3rem;
    }
    .inbox-heading p {
      font-size: 1rem;
    }
    .mail-row > div > span {
      max-width: 145px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .domain-note {
      left: 0;
      padding: 0.7rem;
      gap: 0.55rem;
    }
    .domain-note strong {
      font-size: 0.85rem;
    }
    .domain-check {
      margin-left: 0;
    }
    .identity-note {
      top: -0.5rem;
      width: 96px;
      height: 112px;
      padding: 0.8rem;
    }
    .identity-note > span:nth-child(2) {
      font-size: 0.55rem;
    }
  }
</style>
