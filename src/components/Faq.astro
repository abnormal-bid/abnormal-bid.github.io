---
import { faqs } from "../data/site";
import Icon from "./Icon.astro";
---

<section
  class="page-shell section-space faq-section"
  id="faq"
  aria-labelledby="faq-title"
>
  <div class="faq-intro">
    <p class="eyebrow">
      <span class="mr-2.5 font-normal text-muted">03 /</span>GOOD QUESTIONS
    </p>
    <h2 class="section-title" id="faq-title">
      你可能还想知道<span class="text-accent">。</span>
    </h2>
    <p class="faq-description">关于邮箱，先把问题说清楚。</p>
    <button class="text-link faq-contact" data-inquiry>
      其他问题，聊聊看 <Icon name="up-right" class="size-4" />
    </button>
  </div>
  <div class="faq-list">
    {faqs.map(({ question, answer }, index) => (
      <details class="faq-item">
        <summary>
          <span class="faq-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="faq-question">{question}</span>
          <span class="faq-toggle">
            <Icon name="plus" class="size-4" />
          </span>
        </summary>
        <p class="faq-answer">{answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    display: grid;
    gap: 2.5rem;
  }
  .faq-description {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .faq-contact {
    margin-top: 1.5rem;
    color: var(--color-accent);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .faq-list {
    border-top: 1px solid var(--color-line);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item summary {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    gap: 1.1rem;
    padding-block: 1.4rem;
    list-style: none;
    line-height: 1.7;
  }
  .faq-number {
    flex-shrink: 0;
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .faq-question {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 180ms ease;
  }
  .faq-toggle {
    display: grid;
    flex-shrink: 0;
    width: 1.875rem;
    height: 1.875rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-muted);
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }
  .faq-item summary:hover .faq-question,
  .faq-item[open] .faq-question {
    color: var(--color-accent);
  }
  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
    background: var(--color-lavender);
    color: var(--color-accent);
  }
  .faq-answer {
    margin: -0.3rem 2.75rem 1.6rem 2rem;
    font-size: 0.875rem;
    line-height: 2;
    color: var(--color-muted);
  }
  @media (width >= 1024px) {
    .faq-section {
      grid-template-columns: 0.85fr 1.3fr;
      gap: 5rem;
    }
    .faq-intro {
      padding-top: 0.75rem;
    }
    .faq-contact {
      margin-top: 2rem;
    }
  }
  @media (width < 375px) {
    .faq-item summary {
      gap: 0.65rem;
    }
    .faq-answer {
      margin-right: 0;
      margin-left: 1.5rem;
    }
  }
</style>
