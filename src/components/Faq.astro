---
import { faqs } from "../data/site";
import Icon from "./Icon.astro";
---

<section
  class="page-shell section-space grid gap-8 lg:grid-cols-[0.85fr_1.25fr] lg:gap-20"
  id="faq"
  aria-labelledby="faq-title"
>
  <div>
    <p class="eyebrow">GOOD QUESTIONS</p>
    <h2 class="section-title" id="faq-title">
      你可能还想知道<span class="text-accent">。</span>
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">
      关于订阅，先把问题说清楚。
    </p>
    <button class="text-link mt-4 text-muted lg:mt-7" data-inquiry>
      其他问题，聊聊看 <span>↗</span>
    </button>
  </div>
  <div class="faq-list border-t border-line">
    {faqs.map(({ question, answer }) => (
      <details class="group border-b border-line">
        <summary class="flex min-h-17 list-none items-center justify-between gap-5 py-5 text-sm leading-relaxed font-medium group-open:text-accent">
          {question}
          <Icon
            name="plus"
            class="size-4 text-muted transition-transform group-open:rotate-45"
          />
        </summary>
        <p class="mr-5 mb-6 text-[0.9375rem] leading-loose text-muted md:text-base">
          {answer}
        </p>
      </details>
    ))}
  </div>
</section>
