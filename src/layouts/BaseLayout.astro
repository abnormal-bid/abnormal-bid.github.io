---
import { site } from "../data/site";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#7357ef" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={site.socialTitle} />
    <meta property="og:description" content={site.socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed top-2 left-2 z-50 -translate-y-[150%] rounded bg-ink px-5 py-3 text-white focus:translate-y-0"
      href="#main"
    >
      跳到主要内容
    </a>
    <slot />
  </body>
</html>
