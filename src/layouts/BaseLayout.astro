---
import themeInitializer from "../scripts/theme-init.js?raw";
import { copies, langs, switchPath, useCopy } from "../i18n";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const { t } = useCopy(Astro.currentLocale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 每个页面都有中英两版：hreflang 互相指向，x-default 指向中文版。
const alternates = langs.map((lang) => ({
  hreflang: copies[lang].htmlLang,
  href: new URL(switchPath(Astro.url.pathname, lang), Astro.site).href,
}));
const defaultAlternate = new URL(switchPath(Astro.url.pathname, "zh"), Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7fc" />
    <script is:inline set:html={themeInitializer}></script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={t.meta.socialTitle} />
    <meta property="og:description" content={t.meta.socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BricolageGrotesque-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed top-3 left-4 z-50 -translate-y-[160%] rounded-control bg-foreground px-3.5 py-2 text-background focus:translate-y-0"
      href="#main"
    >
      {t.skipLink}
    </a>
    <slot />
  </body>
</html>
