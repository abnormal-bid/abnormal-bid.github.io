---
import type { MarkdownLayoutProps } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InquiryDialog from "../components/InquiryDialog.astro";
import Icon from "../components/Icon.astro";
import { legalPages, site } from "../data/site";
import { getTelegramUrl } from "../lib/inquiry";

interface LegalFrontmatter {
  title: string;
  description: string;
  eyebrow: string;
  summary: string;
  effective: string;
  updated: string;
  highlights: string[];
}
type Props = MarkdownLayoutProps<LegalFrontmatter>;

const { frontmatter, headings } = Astro.props;
const { title, description, eyebrow, summary, effective, updated, highlights } =
  frontmatter;

const currentPath = Astro.url.pathname.replace(/\/+$/, "");
const relatedPages = legalPages.filter(
  ({ href }) => href.replace(/\/+$/, "") !== currentPath,
);
const sections = [
  ...headings.filter(({ depth }) => depth === 2),
  { depth: 2, slug: "contact", text: "联系我们" },
];

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  dateStyle: "long",
  timeZone: "UTC",
});
const formatDate = (value: string) =>
  dateFormatter.format(new Date(`${value}T00:00:00Z`));

const email = site.contact.email.trim();
const wechat = site.contact.wechat.trim();
const telegram = getTelegramUrl(site.contact.telegram);
const contacts: { label: string; value: string; href?: string }[] = [];
if (email)
  contacts.push({ label: "邮箱", value: email, href: `mailto:${email}` });
if (wechat) contacts.push({ label: "微信", value: wechat });
if (telegram)
  contacts.push({ label: "Telegram", value: telegram, href: telegram });
---

<BaseLayout title={`${title} — Abnormal`} description={description}>
  <Header />
  <main id="main">
    <section class="legal-hero" aria-labelledby="legal-title">
      <div class="page-shell legal-hero-inner">
        <div class="legal-hero-copy">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="legal-title" id="legal-title">
            {title}
            <span class="text-accent">。</span>
          </h1>
          <p class="legal-summary">{summary}</p>
        </div>
        <dl class="legal-dates">
          <div>
            <dt>生效日期</dt>
            <dd>
              <time datetime={effective}>{formatDate(effective)}</time>
            </dd>
          </div>
          <div>
            <dt>最后更新</dt>
            <dd>
              <time datetime={updated}>{formatDate(updated)}</time>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="page-shell section-space legal-layout">
      <aside class="legal-sidebar">
        <nav aria-label="目录">
          <p class="legal-nav-label">
            本页目录 <span>CONTENTS</span>
          </p>
          <ol class="legal-nav-list">
            {sections.map(({ slug, text }, index) => (
              <li>
                <a class="legal-nav-link" href={`#${slug}`}>
                  <span class="legal-nav-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="min-w-0">
        <div class="legal-highlights">
          <div class="highlights-heading">
            <p class="highlights-label">要点速览</p>
            <p class="highlights-note">摘要仅供快速了解，具体以正文为准。</p>
          </div>
          <ul class="highlights-list">
            {highlights.map((item) => (
              <li>
                <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="legal-body">
          <slot />
          <section id="contact">
            <h2>联系我们</h2>
            <p>
              如对本{title}
              有任何疑问，或需要查询、更正、删除你的信息，请通过以下方式联系我们。为便于处理，请说明你的诉求及相关订单信息；请勿在消息中发送密码、验证码或支付卡信息。
            </p>
            {contacts.length > 0 ? (
              <ul>
                {contacts.map(({ label, value, href }) => (
                  <li>
                    {label}：
                    {href ? (
                      <a
                        href={href}
                        rel={
                          href.startsWith("mailto:")
                            ? undefined
                            : "noopener noreferrer"
                        }
                      >
                        {value}
                      </a>
                    ) : (
                      value
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p>联系渠道即将公布，公布后会更新在本页面。</p>
            )}
          </section>
        </div>

        <nav class="legal-related" aria-label="相关页面">
          {relatedPages.map(({ href, label }) => (
            <a class="text-link text-muted" href={href}>
              另见 {label} <Icon name="up-right" class="size-4" />
            </a>
          ))}
          <a class="text-link text-muted" href="/">
            返回首页 <Icon name="arrow" class="size-4" />
          </a>
        </nav>
      </article>
    </div>
  </main>
  <Footer />
  <InquiryDialog />
</BaseLayout>

<style>
  .legal-hero {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-subtle);
  }
  .legal-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 3.5rem;
  }
  .legal-hero-copy {
    max-width: 40rem;
  }
  .legal-title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .legal-summary {
    margin-top: 1.25rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.95;
  }
  .legal-dates {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 1.5rem 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .legal-dates dt {
    color: var(--color-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
  .legal-dates dd {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .legal-layout {
    display: grid;
    gap: 2.5rem;
  }
  .legal-nav-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .legal-nav-label span {
    color: var(--color-muted);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }
  .legal-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .legal-nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    color: var(--color-muted);
    background: var(--color-surface);
    font-size: 0.75rem;
    line-height: 1.6;
    transition:
      color 180ms ease,
      background 180ms ease;
  }
  .legal-nav-link:hover {
    color: var(--color-accent);
    background: var(--color-lavender);
  }
  .legal-nav-number {
    flex-shrink: 0;
    color: var(--color-accent);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }
  .legal-highlights {
    padding: 1.4rem;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: var(--color-lavender);
  }
  .highlights-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .highlights-label {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .highlights-note {
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.8;
  }
  .highlights-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.15rem;
  }
  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  .legal-related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  .legal-body {
    counter-reset: legal-section;
    font-size: 0.9375rem;
    line-height: 2;
    color: var(--color-muted);
  }
  .legal-body :global(h2) {
    counter-increment: legal-section;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 3.25rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .legal-body :global(h2)::before {
    content: counter(legal-section, decimal-leading-zero);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }
  .legal-body :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal-body :global(p + p),
  .legal-body :global(ul + p),
  .legal-body :global(ol + p) {
    margin-top: 1rem;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    display: grid;
    gap: 0.5rem;
    margin-block: 1rem;
    padding-left: 1.25rem;
  }
  .legal-body :global(ul) {
    list-style: disc;
  }
  .legal-body :global(ol) {
    list-style: decimal;
  }
  .legal-body :global(li)::marker {
    color: var(--color-accent);
  }
  .legal-body :global(li > p) {
    margin: 0;
  }
  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }
  .legal-body :global(a):hover {
    text-decoration-thickness: 2px;
  }
  .legal-body :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 0.25rem;
    background: var(--color-lavender);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    color: var(--color-ink);
  }
  @media (width >= 768px) {
    .legal-hero-inner {
      padding-block: 4.5rem;
    }
    .legal-highlights {
      padding: 1.75rem 2rem;
    }
    .highlights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    .legal-body {
      font-size: 1rem;
    }
    .legal-body :global(h2) {
      font-size: 1.375rem;
    }
  }
  @media (width >= 1024px) {
    .legal-hero-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3.5rem;
    }
    .legal-dates {
      flex-direction: column;
      gap: 1.4rem;
      min-width: 11rem;
      padding: 0 0 0 2rem;
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
    .legal-layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 5rem;
    }
    .legal-sidebar {
      position: sticky;
      top: 7.5rem;
      align-self: start;
    }
    .legal-nav-list {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--color-line);
    }
    .legal-nav-list li {
      border-bottom: 1px solid var(--color-line);
    }
    .legal-nav-link {
      width: 100%;
      padding: 0.85rem 0.2rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 0.8125rem;
    }
  }
</style>
