---
import type { MarkdownLayoutProps } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InquiryDialog from "../components/InquiryDialog.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { stripLocale, useCopy } from "../i18n";
import { getTelegramUrl } from "../lib/inquiry";

interface LegalFrontmatter {
  title: string;
  description: string;
  eyebrow: string;
  summary: string;
  effective: string;
  updated: string;
  highlights: string[];
}
type Props = MarkdownLayoutProps<LegalFrontmatter>;

const { frontmatter, headings } = Astro.props;
const { title, description, eyebrow, summary, effective, updated, highlights } =
  frontmatter;

// 中文版在 src/pages/*.md，英文版在 src/pages/en/*.md；界面文案按页面路径取语言。
const { t, path } = useCopy(Astro.currentLocale);
const l = t.legal;
const currentPath = stripLocale(Astro.url.pathname).replace(/\/+$/, "");
const relatedPages = t.legalPages.filter(
  ({ path: page }) => page.replace(/\/+$/, "") !== currentPath,
);
const sections = [
  ...headings.filter(({ depth }) => depth === 2),
  { depth: 2, slug: "contact", text: l.contactTitle },
];

const dateFormatter = new Intl.DateTimeFormat(l.dateLocale, {
  dateStyle: "long",
  timeZone: "UTC",
});
const formatDate = (value: string) =>
  dateFormatter.format(new Date(`${value}T00:00:00Z`));

const email = site.contact.email.trim();
const wechat = site.contact.wechat.trim();
const telegram = getTelegramUrl(site.contact.telegram);
const contacts: { label: string; value: string; href?: string }[] = [];
if (email)
  contacts.push({
    label: l.contactLabels.email,
    value: email,
    href: `mailto:${email}`,
  });
if (wechat) contacts.push({ label: l.contactLabels.wechat, value: wechat });
if (telegram)
  contacts.push({
    label: l.contactLabels.telegram,
    value: telegram,
    href: telegram,
  });
---

<BaseLayout title={`${title} — Abnormal`} description={description}>
  <Header />
  <main id="main">
    <section class="legal-hero" aria-labelledby="legal-title">
      <div class="page-shell legal-hero-inner">
        <div class="legal-hero-copy">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="legal-title" id="legal-title">
            {title}
            <span class="text-brand">{t.dot}</span>
          </h1>
          <p class="legal-summary">{summary}</p>
        </div>
        <dl class="legal-dates">
          <div>
            <dt>{l.effective}</dt>
            <dd>
              <time datetime={effective}>{formatDate(effective)}</time>
            </dd>
          </div>
          <div>
            <dt>{l.updated}</dt>
            <dd>
              <time datetime={updated}>{formatDate(updated)}</time>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="page-shell section-space legal-layout">
      <aside class="legal-sidebar">
        <nav aria-label={l.tocLabel}>
          <p class="legal-nav-label">
            {l.tocHint} <span>CONTENTS</span>
          </p>
          <ol class="legal-nav-list">
            {sections.map(({ slug, text }, index) => (
              <li>
                <a class="legal-nav-link" href={`#${slug}`}>
                  <span class="legal-nav-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="min-w-0">
        <div class="legal-highlights">
          <div class="highlights-heading">
            <p class="highlights-label">{l.highlights}</p>
            <p class="highlights-note">{l.highlightsNote}</p>
          </div>
          <ul class="highlights-list">
            {highlights.map((item) => (
              <li>
                <Icon
                  name="check"
                  class="mt-1 size-4 shrink-0 text-foreground"
                />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="legal-body">
          <slot />
          <section id="contact">
            <h2>{l.contactTitle}</h2>
            <p>{l.contactBody(title)}</p>
            {contacts.length > 0 ? (
              <ul>
                {contacts.map(({ label, value, href }) => (
                  <li>
                    {label}
                    {l.colon}
                    {href ? (
                      <a
                        href={href}
                        rel={
                          href.startsWith("mailto:")
                            ? undefined
                            : "noopener noreferrer"
                        }
                      >
                        {value}
                      </a>
                    ) : (
                      value
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p>{l.contactPending}</p>
            )}
          </section>
        </div>

        <nav class="legal-related" aria-label={l.relatedLabel}>
          {relatedPages.map(({ path: page, label }) => (
            <a class="text-link" href={path(page)}>
              {l.seeAlso(label)} <Icon name="up-right" class="size-4" />
            </a>
          ))}
          <a class="text-link" href={path("/")}>
            {l.backHome} <Icon name="arrow" class="size-4" />
          </a>
        </nav>
      </article>
    </div>
  </main>
  <Footer />
  <InquiryDialog />
</BaseLayout>

<style>
  .legal-hero {
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .legal-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 3.5rem;
  }
  .legal-hero-copy {
    max-width: 40rem;
  }
  .legal-title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1.25;
  }
  .legal-summary {
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }
  .legal-dates {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 1.5rem 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .legal-dates dt {
    color: var(--text-secondary);
    font-size: 12px;
  }
  .legal-dates dd {
    margin-top: 0.4rem;
    font-size: 14px;
    font-weight: 500;
  }
  .legal-layout {
    display: grid;
    gap: 2.5rem;
  }
  .legal-nav-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
  }
  .legal-nav-label span {
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  .legal-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .legal-nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--input);
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    background: var(--control);
    font-size: 13px;
    line-height: 1.6;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .legal-nav-link:hover {
    color: var(--text);
    background: var(--hover);
  }
  .legal-nav-number {
    flex-shrink: 0;
    color: var(--text-secondary);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .legal-highlights {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--card);
  }
  .highlights-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .highlights-label {
    font-size: 15px;
    font-weight: 600;
  }
  .highlights-note {
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.8;
  }
  .highlights-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.15rem;
  }
  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 14px;
    line-height: 1.75;
  }
  .legal-related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .legal-body {
    counter-reset: legal-section;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-secondary);
  }
  .legal-body :global(h2) {
    counter-increment: legal-section;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 3.25rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    line-height: 1.5;
    font-weight: 600;
    color: var(--text);
  }
  .legal-body :global(h2)::before {
    content: counter(legal-section, decimal-leading-zero);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    color: var(--brand);
  }
  .legal-body :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }
  .legal-body :global(p + p),
  .legal-body :global(ul + p),
  .legal-body :global(ol + p) {
    margin-top: 1rem;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    display: grid;
    gap: 0.5rem;
    margin-block: 1rem;
    padding-left: 1.25rem;
  }
  .legal-body :global(ul) {
    list-style: disc;
  }
  .legal-body :global(ol) {
    list-style: decimal;
  }
  .legal-body :global(li)::marker {
    color: var(--text-secondary);
  }
  .legal-body :global(li > p) {
    margin: 0;
  }
  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--text);
  }
  .legal-body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--input);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.15s;
  }
  .legal-body :global(a):hover {
    text-decoration-color: currentColor;
  }
  .legal-body :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
  }
  @media (width >= 768px) {
    .legal-hero-inner {
      padding-block: 4.5rem;
    }
    .legal-highlights {
      padding: 1.75rem 2rem;
    }
    .highlights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    .legal-body :global(h2) {
      font-size: 1.375rem;
    }
  }
  @media (width >= 1024px) {
    .legal-hero-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3.5rem;
    }
    .legal-dates {
      flex-direction: column;
      gap: 1.4rem;
      min-width: 11rem;
      padding: 0 0 0 2rem;
      border-top: 0;
      border-left: 1px solid var(--border);
    }
    .legal-layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 5rem;
    }
    .legal-sidebar {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
    .legal-nav-list {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--border);
    }
    .legal-nav-list li {
      border-bottom: 1px solid var(--border);
    }
    .legal-nav-link {
      width: 100%;
      padding: 0.85rem 0.2rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 0.8125rem;
    }
  }
</style>
